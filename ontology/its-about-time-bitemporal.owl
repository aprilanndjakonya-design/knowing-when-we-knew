        <rdfs:label xml:lang="en">individual organism</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/biolink/vocab/InformationContentEntity -->

    <owl:Class rdf:about="https://w3id.org/biolink/vocab/InformationContentEntity">
        <rdfs:subClassOf rdf:resource="https://w3id.org/biolink/vocab/NamedThing"/>
        <rdfs:label xml:lang="en">information content entity</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/biolink/vocab/MolecularMixture -->

    <owl:Class rdf:about="https://w3id.org/biolink/vocab/MolecularMixture">
        <rdfs:subClassOf rdf:resource="https://w3id.org/biolink/vocab/ChemicalMixture"/>
        <rdfs:label xml:lang="en">molecular mixture</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/biolink/vocab/NamedThing -->

    <owl:Class rdf:about="https://w3id.org/biolink/vocab/NamedThing">
        <rdfs:label xml:lang="en">named thing</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/biolink/vocab/OrganismalEntity -->

    <owl:Class rdf:about="https://w3id.org/biolink/vocab/OrganismalEntity">
        <rdfs:subClassOf rdf:resource="https://w3id.org/biolink/vocab/BiologicalEntity"/>
        <rdfs:label xml:lang="en">organismal entity</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/biolink/vocab/Publication -->

    <owl:Class rdf:about="https://w3id.org/biolink/vocab/Publication">
        <rdfs:subClassOf rdf:resource="https://w3id.org/biolink/vocab/InformationContentEntity"/>
        <rdfs:label xml:lang="en">publication</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/iat-bitemporal/ontology#AsOfSafetyCheck -->

    <owl:Class rdf:about="https://w3id.org/iat-bitemporal/ontology#AsOfSafetyCheck">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/iat-bitemporal/ontology#checksPrescription"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/iat-bitemporal/ontology#PrescriptionEvent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/iat-bitemporal/ontology#evaluatedAsOf"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">as-of safety check</rdfs:label>
        <skos:definition xml:lang="en">A decision-support or audit evaluation of a prescription performed as of an instant T, using only records available at T.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/iat-bitemporal/ontology#BitemporalAssociation -->

    <owl:Class rdf:about="https://w3id.org/iat-bitemporal/ontology#BitemporalAssociation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/biolink/vocab/Association"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/iat-bitemporal/ontology#TemporalKnowledgeRecord"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/iat-bitemporal/ontology#derivedFrom"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/iat-bitemporal/ontology#TemporalKnowledgeRecord"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">bitemporal association</rdfs:label>
        <skos:definition xml:lang="en">A Biolink-style association (subject, predicate, object as Biolink slots) that is also a temporal knowledge record, i.e. carries OWL-Time valid time and an availability time. Derived associations must not become available before the records they are derived from.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/iat-bitemporal/ontology#BoxedWarning -->

    <owl:Class rdf:about="https://w3id.org/iat-bitemporal/ontology#BoxedWarning">
        <rdfs:subClassOf rdf:resource="https://w3id.org/iat-bitemporal/ontology#SafetyWarning"/>
        <rdfs:label xml:lang="en">boxed warning</rdfs:label>
        <skos:definition xml:lang="en">A safety warning placed in the Boxed Warning section of US prescription drug labeling (SPL section LOINC 34066-1).</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/iat-bitemporal/ontology#CheckRaisingBoxedWarning -->

    <owl:Class rdf:about="https://w3id.org/iat-bitemporal/ontology#CheckRaisingBoxedWarning">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/iat-bitemporal/ontology#AsOfSafetyCheck"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/iat-bitemporal/ontology#usedRecord"/>
                        <owl:someValuesFrom>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://w3id.org/iat-bitemporal/ontology#attests"/>
                                <owl:someValuesFrom rdf:resource="https://w3id.org/iat-bitemporal/ontology#BoxedWarning"/>
                            </owl:Restriction>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:label xml:lang="en">check raising a boxed warning</rdfs:label>
        <skos:definition xml:lang="en">An as-of safety check that used at least one record attesting a boxed warning (defined class; membership is inferred).</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/iat-bitemporal/ontology#ClinicalAssertion -->

    <owl:Class rdf:about="https://w3id.org/iat-bitemporal/ontology#ClinicalAssertion">
        <rdfs:subClassOf rdf:resource="https://w3id.org/iat-bitemporal/ontology#TemporalKnowledgeRecord"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/iat-bitemporal/ontology#aboutPatient"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/iat-bitemporal/ontology#SyntheticPatient"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">clinical assertion</rdfs:label>
        <skos:definition xml:lang="en">A patient-level record (e.g. a diagnosis or a prescription entry) with its own valid time and the time it was entered in the record system.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/iat-bitemporal/ontology#ClinicalEvent -->

    <owl:Class rdf:about="https://w3id.org/iat-bitemporal/ontology#ClinicalEvent">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <rdfs:label xml:lang="en">clinical event</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/iat-bitemporal/ontology#DiagnosisAssertion -->

    <owl:Class rdf:about="https://w3id.org/iat-bitemporal/ontology#DiagnosisAssertion">
        <rdfs:subClassOf rdf:resource="https://w3id.org/iat-bitemporal/ontology#ClinicalAssertion"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/iat-bitemporal/ontology#assertsCondition"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/biolink/vocab/Disease"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://w3id.org/iat-bitemporal/ontology#PrescriptionRecord"/>
        <rdfs:label xml:lang="en">diagnosis assertion</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/iat-bitemporal/ontology#DrugProduct -->

    <owl:Class rdf:about="https://w3id.org/iat-bitemporal/ontology#DrugProduct">
        <rdfs:subClassOf rdf:resource="https://w3id.org/biolink/vocab/Drug"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/iat-bitemporal/ontology#rxcui"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">drug product</rdfs:label>
        <skos:definition xml:lang="en">A marketed drug product identified at the RxNorm branded or clinical drug level.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/iat-bitemporal/ontology#GlatiramerAcetateProduct -->

    <owl:Class rdf:about="https://w3id.org/iat-bitemporal/ontology#GlatiramerAcetateProduct">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/iat-bitemporal/ontology#DrugProduct"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/iat-bitemporal/ontology#hasActiveIngredient"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_749565"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:label xml:lang="en">glatiramer acetate product</rdfs:label>
        <skos:definition xml:lang="en">A drug product with glatiramer acetate (ChEBI) as active ingredient (defined class; membership is inferred).</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/iat-bitemporal/ontology#KnowledgeSource -->

    <owl:Class rdf:about="https://w3id.org/iat-bitemporal/ontology#KnowledgeSource">
        <rdfs:label xml:lang="en">knowledge source</rdfs:label>
        <skos:definition xml:lang="en">A database, publication channel or record system from which temporal knowledge records are obtained. Where it exists, its Biolink infores identifier is given with iat:inforesId.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/iat-bitemporal/ontology#KnownAsOf_20240614T150000Z -->

    <owl:Class rdf:about="https://w3id.org/iat-bitemporal/ontology#KnownAsOf_20240614T150000Z">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/iat-bitemporal/ontology#TemporalKnowledgeRecord"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/iat-bitemporal/ontology#knownFrom"/>
                        <owl:someValuesFrom>
                            <rdfs:Datatype>
                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
                                <owl:withRestrictions rdf:parseType="Collection">
                                    <rdf:Description>
                                        <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTimeStamp">2024-06-14T15:00:00Z</xsd:maxInclusive>
                                    </rdf:Description>
                                </owl:withRestrictions>
                            </rdfs:Datatype>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:label xml:lang="en">known as of 2024-06-14T15:00:00Z</rdfs:label>
        <skos:definition xml:lang="en">Records whose availability time is on or before 2024-06-14T15:00:00Z (first prescription).</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/iat-bitemporal/ontology#KnownAsOf_20250123T150000Z -->

    <owl:Class rdf:about="https://w3id.org/iat-bitemporal/ontology#KnownAsOf_20250123T150000Z">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/iat-bitemporal/ontology#TemporalKnowledgeRecord"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/iat-bitemporal/ontology#knownFrom"/>
                        <owl:someValuesFrom>
                            <rdfs:Datatype>
                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
                                <owl:withRestrictions rdf:parseType="Collection">
                                    <rdf:Description>
                                        <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTimeStamp">2025-01-23T15:00:00Z</xsd:maxInclusive>
                                    </rdf:Description>
                                </owl:withRestrictions>
                            </rdfs:Datatype>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:label xml:lang="en">known as of 2025-01-23T15:00:00Z</rdfs:label>
        <skos:definition xml:lang="en">Records whose availability time is on or before 2025-01-23T15:00:00Z (after the FDA communication, before the new label reached DailyMed).</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/iat-bitemporal/ontology#KnownAsOf_20250314T150000Z -->

    <owl:Class rdf:about="https://w3id.org/iat-bitemporal/ontology#KnownAsOf_20250314T150000Z">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/iat-bitemporal/ontology#TemporalKnowledgeRecord"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/iat-bitemporal/ontology#knownFrom"/>
                        <owl:someValuesFrom>
                            <rdfs:Datatype>
                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
                                <owl:withRestrictions rdf:parseType="Collection">
                                    <rdf:Description>
                                        <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTimeStamp">2025-03-14T15:00:00Z</xsd:maxInclusive>
                                    </rdf:Description>
                                </owl:withRestrictions>
                            </rdfs:Datatype>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:label xml:lang="en">known as of 2025-03-14T15:00:00Z</rdfs:label>
        <skos:definition xml:lang="en">Records whose availability time is on or before 2025-03-14T15:00:00Z (second prescription).</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/iat-bitemporal/ontology#LabelSet -->

    <owl:Class rdf:about="https://w3id.org/iat-bitemporal/ontology#LabelSet">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/biolink/vocab/DrugLabel"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/iat-bitemporal/ontology#labelFor"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/iat-bitemporal/ontology#DrugProduct"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/iat-bitemporal/ontology#splSetId"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">label set</rdfs:label>
        <skos:definition xml:lang="en">The evolving drug label identified by one SPL set id; it has a sequence of label versions.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/iat-bitemporal/ontology#LabelVersion -->

    <owl:Class rdf:about="https://w3id.org/iat-bitemporal/ontology#LabelVersion">
        <rdfs:subClassOf rdf:resource="https://w3id.org/biolink/vocab/DrugLabel"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/iat-bitemporal/ontology#TemporalKnowledgeRecord"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/iat-bitemporal/ontology#versionOf"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/iat-bitemporal/ontology#LabelSet"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/iat-bitemporal/ontology#containsBoxedWarningSection"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/iat-bitemporal/ontology#splVersion"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">label version</rdfs:label>
        <skos:definition xml:lang="en">One published version of a structured product label (SPL) document. Valid time: from its SPL effective date until the effective date of the version that supersedes it. Availability: its DailyMed publication date.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/iat-bitemporal/ontology#LabelingChangeRecord -->

    <owl:Class rdf:about="https://w3id.org/iat-bitemporal/ontology#LabelingChangeRecord">
        <rdfs:subClassOf rdf:resource="https://w3id.org/iat-bitemporal/ontology#TemporalKnowledgeRecord"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/iat-bitemporal/ontology#describesEvent"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/iat-bitemporal/ontology#LabelingSupplementApproval"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/iat-bitemporal/ontology#supplementNumber"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">labeling change record</rdfs:label>
        <skos:definition xml:lang="en">An entry of the FDA Drug Safety-related Labeling Changes (SrLC) database describing an approved labeling supplement.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/iat-bitemporal/ontology#LabelingSupplementApproval -->

    <owl:Class rdf:about="https://w3id.org/iat-bitemporal/ontology#LabelingSupplementApproval">
        <rdfs:subClassOf rdf:resource="https://w3id.org/iat-bitemporal/ontology#RegulatoryEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/iat-bitemporal/ontology#occursAt"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.w3.org/2006/time#Instant"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">labeling supplement approval</rdfs:label>
        <skos:definition xml:lang="en">FDA approval of a supplement that changes the labeling of an approved application.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/iat-bitemporal/ontology#PrescriptionEvent -->

    <owl:Class rdf:about="https://w3id.org/iat-bitemporal/ontology#PrescriptionEvent">
        <rdfs:subClassOf rdf:resource="https://w3id.org/iat-bitemporal/ontology#ClinicalEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/iat-bitemporal/ontology#hasPatient"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/iat-bitemporal/ontology#SyntheticPatient"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/iat-bitemporal/ontology#occursAt"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.w3.org/2006/time#Instant"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/iat-bitemporal/ontology#prescribedProduct"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/iat-bitemporal/ontology#DrugProduct"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">prescription event</rdfs:label>
        <skos:definition xml:lang="en">The act of prescribing a drug product to a patient at an instant.</skos:definition>
        <skos:relatedMatch rdf:resource="https://w3id.org/biolink/vocab/DrugExposure"/>
    </owl:Class>
    


    <!-- https://w3id.org/iat-bitemporal/ontology#PrescriptionRecord -->

    <owl:Class rdf:about="https://w3id.org/iat-bitemporal/ontology#PrescriptionRecord">
        <rdfs:subClassOf rdf:resource="https://w3id.org/iat-bitemporal/ontology#ClinicalAssertion"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/iat-bitemporal/ontology#documentsEvent"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/iat-bitemporal/ontology#PrescriptionEvent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">prescription record</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/iat-bitemporal/ontology#RegulatoryEvent -->

    <owl:Class rdf:about="https://w3id.org/iat-bitemporal/ontology#RegulatoryEvent">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <rdfs:label xml:lang="en">regulatory event</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/iat-bitemporal/ontology#SafetyCommunication -->

    <owl:Class rdf:about="https://w3id.org/iat-bitemporal/ontology#SafetyCommunication">
        <rdfs:subClassOf rdf:resource="https://w3id.org/biolink/vocab/Publication"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/iat-bitemporal/ontology#TemporalKnowledgeRecord"/>
        <rdfs:label xml:lang="en">safety communication</rdfs:label>
        <skos:definition xml:lang="en">A dated public regulatory communication about a drug safety issue (e.g. an FDA Drug Safety Communication).</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/iat-bitemporal/ontology#SafetyWarning -->

    <owl:Class rdf:about="https://w3id.org/iat-bitemporal/ontology#SafetyWarning">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/iat-bitemporal/ontology#concernsProduct"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/iat-bitemporal/ontology#DrugProduct"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty>
                    <rdf:Description>
                        <owl:inverseOf rdf:resource="https://w3id.org/iat-bitemporal/ontology#attests"/>
                    </rdf:Description>
                </owl:onProperty>
                <owl:someValuesFrom rdf:resource="https://w3id.org/iat-bitemporal/ontology#TemporalKnowledgeRecord"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/iat-bitemporal/ontology#hasValidTime"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.w3.org/2006/time#ProperInterval"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">safety warning</rdfs:label>
        <skos:definition xml:lang="en">A regulatory safety warning about a drug product and a hazard. Its valid time is the period in which the warning is in force; it is known only through records that attest it.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/iat-bitemporal/ontology#SyntheticPatient -->

    <owl:Class rdf:about="https://w3id.org/iat-bitemporal/ontology#SyntheticPatient">
        <rdfs:subClassOf rdf:resource="https://w3id.org/biolink/vocab/Case"/>
        <rdfs:label xml:lang="en">synthetic patient</rdfs:label>
        <skos:definition xml:lang="en">A computer-generated or hand-authored patient used for demonstration. Contains no protected health information.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/iat-bitemporal/ontology#TemporalKnowledgeRecord -->

    <owl:Class rdf:about="https://w3id.org/iat-bitemporal/ontology#TemporalKnowledgeRecord">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/iat-bitemporal/ontology#hasValidTime"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.w3.org/2006/time#ProperInterval"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://www.w3.org/2006/time#hasBeginning"/>
                                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                                <owl:onClass rdf:resource="http://www.w3.org/2006/time#Instant"/>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://www.w3.org/2006/time#hasEnd"/>
                                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                                <owl:onClass rdf:resource="http://www.w3.org/2006/time#Instant"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/iat-bitemporal/ontology#hasValidTime"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.w3.org/2006/time#ProperInterval"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/iat-bitemporal/ontology#recordedIn"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/iat-bitemporal/ontology#KnowledgeSource"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/iat-bitemporal/ontology#knownFrom"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">An unknown availability time is allowed by the open-world semantics (the value exists but is not stated); as-of queries treat such records as NOT available (fail-closed).</rdfs:comment>
        <rdfs:label xml:lang="en">temporal knowledge record</rdfs:label>
        <skos:definition xml:lang="en">An information content entity that asserts something about the world and carries exactly one valid time (when its content holds) and exactly one availability time (when it became available to a reasoner), and is recorded in exactly one knowledge source.</skos:definition>
    </owl:Class>
    


