        <rdfs:subClassOf rdf:resource="https://w3id.org/biolink/vocab/DiseaseOrPhenotypicFeature"/>
        <rdfs:label xml:lang="en">disease</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/biolink/vocab/DiseaseOrPhenotypicFeature -->

    <owl:Class rdf:about="https://w3id.org/biolink/vocab/DiseaseOrPhenotypicFeature">
