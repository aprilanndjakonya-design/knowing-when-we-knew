<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/iat-bitemporal/ontology#"
     xml:base="https://w3id.org/iat-bitemporal/ontology"
     xmlns:iat="https://w3id.org/iat-bitemporal/ontology#"
     xmlns:obo="http://purl.obolibrary.org/obo/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:iatd="https://w3id.org/iat-bitemporal/data/"
     xmlns:prov="http://www.w3.org/ns/prov#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:time="http://www.w3.org/2006/time#"
     xmlns:biolink="https://w3id.org/biolink/vocab/"
     xmlns:dcterms="http://purl.org/dc/terms/"
     xmlns:oboInOwl="http://www.geneontology.org/formats/oboInOwl#">
    <owl:Ontology rdf:about="https://w3id.org/iat-bitemporal/ontology">
        <owl:versionIRI rdf:resource="https://w3id.org/iat-bitemporal/ontology/0.1.1"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-07</dcterms:created>
        <dcterms:creator>April Ann Djakonya</dcterms:creator>
        <dcterms:creator>Denis Bardin</dcterms:creator>
        <dcterms:description xml:lang="en">OWL 2 DL fragment showing how a biomedical knowledge graph can represent and reason about time without temporal leakage. Each record has a valid time (OWL-Time proper interval) and an availability time (when it became known). As-of views are OWL defined classes over availability time; a decision record is constrained to use only records of its as-of view, so a reasoner reports any use of later-available knowledge as a logical inconsistency.</dcterms:description>
        <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-11</dcterms:modified>
        <dcterms:title xml:lang="en">Bitemporal Biomedical Knowledge Ontology (Phase 1 fragment)</dcterms:title>
        <rdfs:comment xml:lang="en">Date normalisation rule (leakage-safe rounding): a day-precision AVAILABILITY date D is encoded as D T23:59:59-12:00, i.e. the last instant of that calendar day anywhere on Earth, so a record can never be seen before it was published in any time zone. Day-precision VALID-TIME boundaries are encoded as D T00:00:00Z.</rdfs:comment>
        <rdfs:comment xml:lang="en">Reused vocabularies (referenced by IRI, axioms for the used terms replicated locally so the file is self-contained for DL reasoners): W3C OWL-Time (http://www.w3.org/2006/time, CC BY 4.0); OBO Relation Ontology / BFO / IAO terms (purl.obolibrary.org); Biolink Model 4.4.5 (https://w3id.org/biolink/vocab/, CC0); MONDO, ChEBI; NLM RxNorm and MeSH identifiers. OWL-Time is not owl:imported because its full release uses xsd:duration, which is outside the OWL 2 datatype map and is rejected by the HermiT reasoner.</rdfs:comment>
        <owl:versionInfo>0.1.1 (draft, 2026-10-11): property renamed to knownFrom; SrLC availability upper bounds from Internet Archive snapshots; authors and licence</owl:versionInfo>
        <skos:editorialNote xml:lang="en">Namespace https://w3id.org/iat-bitemporal/ : registration at w3id.org is in preparation; until it is active the IRIs do not resolve.</skos:editorialNote>
    </owl:Ontology>
    


