    <owl:AnnotationProperty rdf:about="https://w3id.org/biolink/vocab/agent_type">
        <rdfs:label xml:lang="en">agent type (Biolink association slot)</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- https://w3id.org/biolink/vocab/knowledge_level -->

    <owl:AnnotationProperty rdf:about="https://w3id.org/biolink/vocab/knowledge_level">
        <rdfs:label xml:lang="en">knowledge level (Biolink association slot)</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- https://w3id.org/biolink/vocab/object -->

    <owl:AnnotationProperty rdf:about="https://w3id.org/biolink/vocab/object">
