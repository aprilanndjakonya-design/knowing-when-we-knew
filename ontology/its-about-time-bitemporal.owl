    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_749565 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_749565">
        <rdfs:subClassOf rdf:resource="https://w3id.org/biolink/vocab/ChemicalEntity"/>
        <oboInOwl:hasDbXref>UNII:5M691HL4BO</oboInOwl:hasDbXref>
        <rdfs:comment xml:lang="en">RXNORM:84375 = precise ingredient (PIN) &apos;glatiramer acetate&apos;; RXNORM:214582 = ingredient (IN) &apos;glatiramer&apos; (RxNav, active since 04/2005). UNII taken from the DailyMed SPL ingredient element. Subclass axiom to biolink:ChemicalEntity is an alignment axiom asserted by this ontology.</rdfs:comment>
        <rdfs:label xml:lang="en">glatiramer acetate</rdfs:label>
        <skos:broadMatch rdf:resource="http://purl.bioontology.org/ontology/RXNORM/214582"/>
        <skos:exactMatch rdf:resource="http://id.nlm.nih.gov/mesh/D000068717"/>
        <skos:exactMatch rdf:resource="http://purl.bioontology.org/ontology/RXNORM/84375"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/IAO_0000030 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/IAO_0000030">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000031"/>
        <rdfs:label xml:lang="en">information content entity</rdfs:label>
        <skos:exactMatch rdf:resource="https://w3id.org/biolink/vocab/InformationContentEntity"/>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0005301 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0005301">
        <rdfs:subClassOf rdf:resource="https://w3id.org/biolink/vocab/Disease"/>
        <oboInOwl:hasDbXref>MESH:D009103</oboInOwl:hasDbXref>
        <rdfs:label xml:lang="en">multiple sclerosis</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0005314 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0005314">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005301"/>
        <oboInOwl:hasDbXref>MESH:D020529</oboInOwl:hasDbXref>
        <rdfs:label xml:lang="en">relapsing-remitting multiple sclerosis</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0100053 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0100053">
        <rdfs:subClassOf rdf:resource="https://w3id.org/biolink/vocab/Disease"/>
        <oboInOwl:hasDbXref>MESH:D000707</oboInOwl:hasDbXref>
        <rdfs:label xml:lang="en">anaphylaxis</rdfs:label>
    </owl:Class>
    


    <!-- http://www.w3.org/2006/time#Instant -->

