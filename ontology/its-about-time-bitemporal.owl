     -->

    


    <!-- http://www.w3.org/2001/XMLSchema#date -->

    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.obolibrary.org/obo/BFO_0000062 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/BFO_0000062">
        <owl:inverseOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000063"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <rdfs:label xml:lang="en">preceded by</rdfs:label>
        <skos:exactMatch rdf:resource="https://w3id.org/biolink/vocab/preceded_by"/>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000063 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/BFO_0000063">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <rdfs:label xml:lang="en">precedes</rdfs:label>
        <skos:exactMatch rdf:resource="https://w3id.org/biolink/vocab/precedes"/>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/RO_0000057 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0000057">
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
        <rdfs:label xml:lang="en">has participant</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/2006/time#hasBeginning -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/2006/time#hasBeginning">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2006/time#hasTime"/>
        <rdfs:domain rdf:resource="http://www.w3.org/2006/time#TemporalEntity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2006/time#Instant"/>
        <rdfs:label xml:lang="en">has beginning</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/2006/time#hasEnd -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/2006/time#hasEnd">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2006/time#hasTime"/>
        <rdfs:domain rdf:resource="http://www.w3.org/2006/time#TemporalEntity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2006/time#Instant"/>
        <rdfs:label xml:lang="en">has end</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/2006/time#hasTime -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/2006/time#hasTime">
        <rdfs:range rdf:resource="http://www.w3.org/2006/time#TemporalEntity"/>
        <rdfs:label xml:lang="en">has time</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/2006/time#intervalMeets -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/2006/time#intervalMeets">
        <owl:inverseOf rdf:resource="http://www.w3.org/2006/time#intervalMetBy"/>
        <rdfs:domain rdf:resource="http://www.w3.org/2006/time#ProperInterval"/>
        <rdfs:range rdf:resource="http://www.w3.org/2006/time#ProperInterval"/>
        <rdfs:label xml:lang="en">interval meets</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/2006/time#intervalMetBy -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/2006/time#intervalMetBy">
        <rdfs:label xml:lang="en">interval met by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/iat-bitemporal/ontology#aboutPatient -->

    <owl:ObjectProperty rdf:about="https://w3id.org/iat-bitemporal/ontology#aboutPatient">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/iat-bitemporal/ontology#ClinicalAssertion"/>
        <rdfs:range rdf:resource="https://w3id.org/iat-bitemporal/ontology#SyntheticPatient"/>
        <rdfs:label xml:lang="en">about patient</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/iat-bitemporal/ontology#announcesWarning -->

    <owl:ObjectProperty rdf:about="https://w3id.org/iat-bitemporal/ontology#announcesWarning">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/iat-bitemporal/ontology#attests"/>
        <rdfs:domain rdf:resource="https://w3id.org/iat-bitemporal/ontology#SafetyCommunication"/>
        <rdfs:range rdf:resource="https://w3id.org/iat-bitemporal/ontology#SafetyWarning"/>
        <rdfs:label xml:lang="en">announces warning</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/iat-bitemporal/ontology#approvesWarning -->

    <owl:ObjectProperty rdf:about="https://w3id.org/iat-bitemporal/ontology#approvesWarning">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/iat-bitemporal/ontology#attests"/>
        <rdfs:domain rdf:resource="https://w3id.org/iat-bitemporal/ontology#LabelingChangeRecord"/>
        <rdfs:range rdf:resource="https://w3id.org/iat-bitemporal/ontology#SafetyWarning"/>
        <rdfs:label xml:lang="en">approves warning</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/iat-bitemporal/ontology#assertsCondition -->

    <owl:ObjectProperty rdf:about="https://w3id.org/iat-bitemporal/ontology#assertsCondition">
        <rdfs:domain rdf:resource="https://w3id.org/iat-bitemporal/ontology#DiagnosisAssertion"/>
        <rdfs:label xml:lang="en">asserts condition</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/iat-bitemporal/ontology#attests -->

    <owl:ObjectProperty rdf:about="https://w3id.org/iat-bitemporal/ontology#attests">
        <rdfs:domain rdf:resource="https://w3id.org/iat-bitemporal/ontology#TemporalKnowledgeRecord"/>
        <rdfs:label xml:lang="en">attests</rdfs:label>
        <skos:definition xml:lang="en">A record states the existence of a regulatory entity such as a safety warning.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/iat-bitemporal/ontology#checksPrescription -->

    <owl:ObjectProperty rdf:about="https://w3id.org/iat-bitemporal/ontology#checksPrescription">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/iat-bitemporal/ontology#AsOfSafetyCheck"/>
        <rdfs:range rdf:resource="https://w3id.org/iat-bitemporal/ontology#PrescriptionEvent"/>
        <rdfs:label xml:lang="en">checks prescription</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/iat-bitemporal/ontology#concernsProduct -->

    <owl:ObjectProperty rdf:about="https://w3id.org/iat-bitemporal/ontology#concernsProduct">
        <rdfs:domain rdf:resource="https://w3id.org/iat-bitemporal/ontology#SafetyWarning"/>
        <rdfs:range rdf:resource="https://w3id.org/iat-bitemporal/ontology#DrugProduct"/>
        <rdfs:label xml:lang="en">concerns product</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/iat-bitemporal/ontology#derivedFrom -->

    <owl:ObjectProperty rdf:about="https://w3id.org/iat-bitemporal/ontology#derivedFrom">
        <rdfs:domain rdf:resource="https://w3id.org/iat-bitemporal/ontology#TemporalKnowledgeRecord"/>
        <rdfs:range rdf:resource="https://w3id.org/iat-bitemporal/ontology#TemporalKnowledgeRecord"/>
        <rdfs:label xml:lang="en">derived from</rdfs:label>
        <skos:exactMatch rdf:resource="http://www.w3.org/ns/prov#wasDerivedFrom"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/iat-bitemporal/ontology#describesEvent -->

    <owl:ObjectProperty rdf:about="https://w3id.org/iat-bitemporal/ontology#describesEvent">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/iat-bitemporal/ontology#LabelingChangeRecord"/>
        <rdfs:range rdf:resource="https://w3id.org/iat-bitemporal/ontology#LabelingSupplementApproval"/>
        <rdfs:label xml:lang="en">describes event</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/iat-bitemporal/ontology#documentsEvent -->

    <owl:ObjectProperty rdf:about="https://w3id.org/iat-bitemporal/ontology#documentsEvent">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/iat-bitemporal/ontology#PrescriptionRecord"/>
        <rdfs:range rdf:resource="https://w3id.org/iat-bitemporal/ontology#PrescriptionEvent"/>
        <rdfs:label xml:lang="en">documents event</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/iat-bitemporal/ontology#endAttestedBy -->

    <owl:ObjectProperty rdf:about="https://w3id.org/iat-bitemporal/ontology#endAttestedBy">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.w3.org/2006/time#ProperInterval"/>
        <rdfs:range rdf:resource="https://w3id.org/iat-bitemporal/ontology#TemporalKnowledgeRecord"/>
        <rdfs:label xml:lang="en">end attested by</rdfs:label>
        <skos:definition xml:lang="en">Links a valid-time interval to the record that revealed its end. The end of a validity interval is itself knowledge: an as-of query may use time:hasEnd only if this record is available at T.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/iat-bitemporal/ontology#hasActiveIngredient -->

    <owl:ObjectProperty rdf:about="https://w3id.org/iat-bitemporal/ontology#hasActiveIngredient">
        <rdfs:domain rdf:resource="https://w3id.org/iat-bitemporal/ontology#DrugProduct"/>
        <rdfs:label xml:lang="en">has active ingredient</rdfs:label>
        <skos:exactMatch rdf:resource="https://w3id.org/biolink/vocab/has_active_ingredient"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/iat-bitemporal/ontology#hasPatient -->

    <owl:ObjectProperty rdf:about="https://w3id.org/iat-bitemporal/ontology#hasPatient">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/iat-bitemporal/ontology#PrescriptionEvent"/>
        <rdfs:range rdf:resource="https://w3id.org/iat-bitemporal/ontology#SyntheticPatient"/>
        <rdfs:label xml:lang="en">has patient</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/iat-bitemporal/ontology#hasValidTime -->

    <owl:ObjectProperty rdf:about="https://w3id.org/iat-bitemporal/ontology#hasValidTime">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/iat-bitemporal/ontology#SafetyWarning"/>
                    <rdf:Description rdf:about="https://w3id.org/iat-bitemporal/ontology#TemporalKnowledgeRecord"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2006/time#ProperInterval"/>
        <rdfs:label xml:lang="en">has valid time</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/biolink/vocab/temporal_interval_qualifier"/>
        <skos:definition xml:lang="en">Relates a record or a warning to the OWL-Time proper interval during which its content holds in the world. An interval without time:hasEnd is open (still holding as far as is known).</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/iat-bitemporal/ontology#hasVersion -->

    <owl:ObjectProperty rdf:about="https://w3id.org/iat-bitemporal/ontology#hasVersion">
        <owl:inverseOf rdf:resource="https://w3id.org/iat-bitemporal/ontology#versionOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/iat-bitemporal/ontology#LabelSet"/>
        <rdfs:range rdf:resource="https://w3id.org/iat-bitemporal/ontology#LabelVersion"/>
        <rdfs:label xml:lang="en">has version</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/iat-bitemporal/ontology#includesWarning -->

    <owl:ObjectProperty rdf:about="https://w3id.org/iat-bitemporal/ontology#includesWarning">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/iat-bitemporal/ontology#attests"/>
        <rdfs:domain rdf:resource="https://w3id.org/iat-bitemporal/ontology#LabelVersion"/>
        <rdfs:range rdf:resource="https://w3id.org/iat-bitemporal/ontology#SafetyWarning"/>
        <rdfs:label xml:lang="en">includes warning</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/iat-bitemporal/ontology#labelFor -->

    <owl:ObjectProperty rdf:about="https://w3id.org/iat-bitemporal/ontology#labelFor">
        <rdfs:domain rdf:resource="https://w3id.org/iat-bitemporal/ontology#LabelSet"/>
        <rdfs:range rdf:resource="https://w3id.org/iat-bitemporal/ontology#DrugProduct"/>
        <rdfs:label xml:lang="en">label for</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/iat-bitemporal/ontology#laterVersionOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/iat-bitemporal/ontology#laterVersionOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/iat-bitemporal/ontology#LabelVersion"/>
        <rdfs:range rdf:resource="https://w3id.org/iat-bitemporal/ontology#LabelVersion"/>
        <rdfs:label xml:lang="en">later version of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/iat-bitemporal/ontology#occursAt -->

    <owl:ObjectProperty rdf:about="https://w3id.org/iat-bitemporal/ontology#occursAt">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2006/time#hasTime"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/iat-bitemporal/ontology#ClinicalEvent"/>
                    <rdf:Description rdf:about="https://w3id.org/iat-bitemporal/ontology#RegulatoryEvent"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2006/time#Instant"/>
        <rdfs:label xml:lang="en">occurs at</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/iat-bitemporal/ontology#prescribedProduct -->

    <owl:ObjectProperty rdf:about="https://w3id.org/iat-bitemporal/ontology#prescribedProduct">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/iat-bitemporal/ontology#PrescriptionEvent"/>
        <rdfs:range rdf:resource="https://w3id.org/iat-bitemporal/ontology#DrugProduct"/>
        <rdfs:label xml:lang="en">prescribed product</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/iat-bitemporal/ontology#recordedIn -->

    <owl:ObjectProperty rdf:about="https://w3id.org/iat-bitemporal/ontology#recordedIn">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/iat-bitemporal/ontology#TemporalKnowledgeRecord"/>
        <rdfs:range rdf:resource="https://w3id.org/iat-bitemporal/ontology#KnowledgeSource"/>
        <rdfs:label xml:lang="en">recorded in</rdfs:label>
        <skos:closeMatch rdf:resource="https://w3id.org/biolink/vocab/primary_knowledge_source"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/iat-bitemporal/ontology#supersedes -->

    <owl:ObjectProperty rdf:about="https://w3id.org/iat-bitemporal/ontology#supersedes">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/iat-bitemporal/ontology#laterVersionOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:label xml:lang="en">supersedes</rdfs:label>
        <skos:closeMatch rdf:resource="http://www.w3.org/ns/prov#wasRevisionOf"/>
        <skos:definition xml:lang="en">Direct succession of label versions: each version supersedes at most one version and is superseded by at most one.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/iat-bitemporal/ontology#usedRecord -->

    <owl:ObjectProperty rdf:about="https://w3id.org/iat-bitemporal/ontology#usedRecord">
        <rdfs:domain rdf:resource="https://w3id.org/iat-bitemporal/ontology#AsOfSafetyCheck"/>
        <rdfs:range rdf:resource="https://w3id.org/iat-bitemporal/ontology#TemporalKnowledgeRecord"/>
        <rdfs:label xml:lang="en">used record</rdfs:label>
        <skos:definition xml:lang="en">A record consulted by an as-of safety check.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/iat-bitemporal/ontology#versionOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/iat-bitemporal/ontology#versionOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/iat-bitemporal/ontology#LabelVersion"/>
        <rdfs:range rdf:resource="https://w3id.org/iat-bitemporal/ontology#LabelSet"/>
        <rdfs:label xml:lang="en">version of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/iat-bitemporal/ontology#warnsAbout -->

    <owl:ObjectProperty rdf:about="https://w3id.org/iat-bitemporal/ontology#warnsAbout">
        <rdfs:domain rdf:resource="https://w3id.org/iat-bitemporal/ontology#SafetyWarning"/>
        <rdfs:label xml:lang="en">warns about</rdfs:label>
        <skos:relatedMatch rdf:resource="https://w3id.org/biolink/vocab/has_adverse_event"/>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/2006/time#inXSDDateTimeStamp -->

    <owl:DatatypeProperty rdf:about="http://www.w3.org/2006/time#inXSDDateTimeStamp">
        <rdfs:domain rdf:resource="http://www.w3.org/2006/time#Instant"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
        <rdfs:label xml:lang="en">in XSD date-time-stamp</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/iat-bitemporal/ontology#applicationNumber -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/iat-bitemporal/ontology#applicationNumber">
        <rdfs:domain rdf:resource="https://w3id.org/iat-bitemporal/ontology#LabelSet"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">FDA application number</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/iat-bitemporal/ontology#containsBoxedWarningSection -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/iat-bitemporal/ontology#containsBoxedWarningSection">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/iat-bitemporal/ontology#LabelVersion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:label xml:lang="en">contains Boxed Warning section</rdfs:label>
        <skos:definition xml:lang="en">Whether the SPL document contains a section coded LOINC 34066-1 (Boxed Warning).</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/iat-bitemporal/ontology#evaluatedAsOf -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/iat-bitemporal/ontology#evaluatedAsOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/iat-bitemporal/ontology#AsOfSafetyCheck"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
        <rdfs:label xml:lang="en">evaluated as of</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/iat-bitemporal/ontology#knownFrom -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/iat-bitemporal/ontology#knownFrom">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/iat-bitemporal/ontology#TemporalKnowledgeRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
        <rdfs:comment xml:lang="en">Named knownFrom (not availableFrom) to avoid confusion with the Biolink slot available_from (the regulatory or commercial availability channel of a drug, DrugAvailabilityEnum). Biolink Model 4.4.5 offers record-keeping dates (creation_date, update_date; dataset-level retrieved_on, ingest_date) and string-serialised temporal qualifiers, but no edge-level time at which the knowledge became available in its primary source; this property fills that gap.</rdfs:comment>
        <rdfs:label xml:lang="en">known from</rdfs:label>
        <skos:definition xml:lang="en">Availability (knowledge) time: the instant from which the record could be known to a reasoner through its knowledge source. An inference as of T may use the record only if knownFrom &lt;= T.</skos:definition>
        <skos:relatedMatch rdf:resource="http://www.w3.org/ns/prov#generatedAtTime"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/iat-bitemporal/ontology#rxcui -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/iat-bitemporal/ontology#rxcui">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/iat-bitemporal/ontology#DrugProduct"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">RxNorm concept unique identifier</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/iat-bitemporal/ontology#rxnormTermType -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/iat-bitemporal/ontology#rxnormTermType">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/iat-bitemporal/ontology#DrugProduct"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">RxNorm term type</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/iat-bitemporal/ontology#splDocumentId -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/iat-bitemporal/ontology#splDocumentId">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/iat-bitemporal/ontology#LabelVersion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">SPL document id</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/iat-bitemporal/ontology#splSetId -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/iat-bitemporal/ontology#splSetId">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/iat-bitemporal/ontology#LabelSet"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">SPL set id</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/iat-bitemporal/ontology#splVersion -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/iat-bitemporal/ontology#splVersion">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/iat-bitemporal/ontology#LabelVersion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label xml:lang="en">SPL version number</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/iat-bitemporal/ontology#supplementNumber -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/iat-bitemporal/ontology#supplementNumber">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/iat-bitemporal/ontology#LabelingChangeRecord"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">supplement number</rdfs:label>
    </owl:DatatypeProperty>
    


