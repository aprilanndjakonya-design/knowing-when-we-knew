        <rdfs:label xml:lang="en">drug</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/biolink/vocab/DrugLabel -->

    <owl:Class rdf:about="https://w3id.org/biolink/vocab/DrugLabel">
