    </owl:AnnotationProperty>
    


    <!-- https://w3id.org/biolink/vocab/subject -->

    <owl:AnnotationProperty rdf:about="https://w3id.org/biolink/vocab/subject">
        <rdfs:label xml:lang="en">subject (Biolink association slot)</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- https://w3id.org/iat-bitemporal/ontology#accessedOn -->

    <owl:AnnotationProperty rdf:about="https://w3id.org/iat-bitemporal/ontology#accessedOn">
        <rdfs:label xml:lang="en">accessed on</rdfs:label>
        <skos:definition xml:lang="en">Date on which the primary source was consulted to verify the asserted values.</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- https://w3id.org/iat-bitemporal/ontology#inforesId -->

    <owl:AnnotationProperty rdf:about="https://w3id.org/iat-bitemporal/ontology#inforesId">
        <rdfs:label xml:lang="en">infores identifier</rdfs:label>
        <skos:definition xml:lang="en">Identifier of a knowledge source in the Biolink Information Resource Registry (infores CURIE).</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- https://w3id.org/iat-bitemporal/ontology#sourceDateText -->

    <owl:AnnotationProperty rdf:about="https://w3id.org/iat-bitemporal/ontology#sourceDateText">
        <rdfs:label xml:lang="en">source date text</rdfs:label>
        <skos:definition xml:lang="en">A date exactly as printed by the primary source, kept for audit before normalisation to xsd:dateTimeStamp.</skos:definition>
    </owl:AnnotationProperty>
    


