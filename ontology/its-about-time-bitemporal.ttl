@prefix iat:      <https://w3id.org/iat-bitemporal/ontology#> .
@prefix iatd:     <https://w3id.org/iat-bitemporal/data/> .
@prefix time:     <http://www.w3.org/2006/time#> .
@prefix obo:      <http://purl.obolibrary.org/obo/> .
@prefix biolink:  <https://w3id.org/biolink/vocab/> .
@prefix prov:     <http://www.w3.org/ns/prov#> .
@prefix skos:     <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms:  <http://purl.org/dc/terms/> .
@prefix oboInOwl: <http://www.geneontology.org/formats/oboInOwl#> .
@prefix owl:      <http://www.w3.org/2002/07/owl#> .
@prefix rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .

#####################################################################################################
# Bitemporal Biomedical Knowledge Ontology -- Phase 1 fragment
# NIH "It's About Time: Temporal Reasoning in Biomedical Knowledge Graphs" Challenge
#
# Core idea: every fact (record) carries TWO times:
#   * valid time        -- when the content of the record holds in the world   (iat:hasValidTime, OWL-Time interval)
#   * availability time -- when the record became available to a reasoner      (iat:knownFrom)
# An inference "as of T" may only use records with knownFrom <= T (no temporal leakage).
#
# Demonstration: glatiramer acetate (Copaxone) and the Boxed Warning on anaphylactic reactions
# (FDA labeling supplement SUPPL-119 to NDA 020622, approved 2025-01-22).
# All regulatory dates/identifiers below were checked against public primary sources on 2026-10-07
# (see dcterms:source on each individual). The patient is hand-authored SYNTHETIC data (no PHI).
#####################################################################################################

<https://w3id.org/iat-bitemporal/ontology>
    a owl:Ontology ;
    owl:versionIRI <https://w3id.org/iat-bitemporal/ontology/0.1.1> ;
    owl:versionInfo "0.1.1 (draft, 2026-10-11): property renamed to knownFrom; SrLC availability upper bounds from Internet Archive snapshots; authors and licence" ;
    dcterms:creator "April Ann Djakonya" , "Denis Bardin" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:title "Bitemporal Biomedical Knowledge Ontology (Phase 1 fragment)"@en ;
    dcterms:description """OWL 2 DL fragment showing how a biomedical knowledge graph can represent and reason about time without temporal leakage. Each record has a valid time (OWL-Time proper interval) and an availability time (when it became known). As-of views are OWL defined classes over availability time; a decision record is constrained to use only records of its as-of view, so a reasoner reports any use of later-available knowledge as a logical inconsistency."""@en ;
    dcterms:created "2026-10-07"^^xsd:date ;
    dcterms:modified "2026-10-11"^^xsd:date ;
    rdfs:comment """Reused vocabularies (referenced by IRI, axioms for the used terms replicated locally so the file is self-contained for DL reasoners): W3C OWL-Time (http://www.w3.org/2006/time, CC BY 4.0); OBO Relation Ontology / BFO / IAO terms (purl.obolibrary.org); Biolink Model 4.4.5 (https://w3id.org/biolink/vocab/, CC0); MONDO, ChEBI; NLM RxNorm and MeSH identifiers. OWL-Time is not owl:imported because its full release uses xsd:duration, which is outside the OWL 2 datatype map and is rejected by the HermiT reasoner."""@en ;
    rdfs:comment """Date normalisation rule (leakage-safe rounding): a day-precision AVAILABILITY date D is encoded as D T23:59:59-12:00, i.e. the last instant of that calendar day anywhere on Earth, so a record can never be seen before it was published in any time zone. Day-precision VALID-TIME boundaries are encoded as D T00:00:00Z."""@en ;
    skos:editorialNote "Namespace https://w3id.org/iat-bitemporal/ : registration at w3id.org is in preparation; until it is active the IRIs do not resolve."@en .

#####################################################################################################
# Annotation properties
#####################################################################################################

skos:definition     a owl:AnnotationProperty .
skos:exactMatch     a owl:AnnotationProperty .
skos:closeMatch     a owl:AnnotationProperty .
skos:relatedMatch   a owl:AnnotationProperty .
skos:broadMatch     a owl:AnnotationProperty .
skos:editorialNote  a owl:AnnotationProperty .
dcterms:title       a owl:AnnotationProperty .
dcterms:description a owl:AnnotationProperty .
dcterms:created     a owl:AnnotationProperty .
dcterms:modified    a owl:AnnotationProperty .
dcterms:creator     a owl:AnnotationProperty .
dcterms:license     a owl:AnnotationProperty .
dcterms:source      a owl:AnnotationProperty .
oboInOwl:hasDbXref  a owl:AnnotationProperty .

biolink:subject         a owl:AnnotationProperty ; rdfs:label "subject (Biolink association slot)"@en .
biolink:predicate       a owl:AnnotationProperty ; rdfs:label "predicate (Biolink association slot)"@en .
biolink:object          a owl:AnnotationProperty ; rdfs:label "object (Biolink association slot)"@en .
biolink:knowledge_level a owl:AnnotationProperty ; rdfs:label "knowledge level (Biolink association slot)"@en .
biolink:agent_type      a owl:AnnotationProperty ; rdfs:label "agent type (Biolink association slot)"@en .

iat:inforesId a owl:AnnotationProperty ;
    rdfs:label "infores identifier"@en ;
    skos:definition "Identifier of a knowledge source in the Biolink Information Resource Registry (infores CURIE)."@en .

iat:sourceDateText a owl:AnnotationProperty ;
    rdfs:label "source date text"@en ;
    skos:definition "A date exactly as printed by the primary source, kept for audit before normalisation to xsd:dateTimeStamp."@en .

iat:accessedOn a owl:AnnotationProperty ;
    rdfs:label "accessed on"@en ;
    skos:definition "Date on which the primary source was consulted to verify the asserted values."@en .

#####################################################################################################
# Reused upper-level terms (BFO, IAO, RO) -- axioms replicated from RO 2026-09-04 / BFO 2019-08-26 / IAO 2026-03-30
#####################################################################################################

obo:BFO_0000002 a owl:Class ; rdfs:label "continuant"@en ; owl:disjointWith obo:BFO_0000003 .
obo:BFO_0000003 a owl:Class ; rdfs:label "occurrent"@en .
obo:BFO_0000015 a owl:Class ; rdfs:label "process"@en ; rdfs:subClassOf obo:BFO_0000003 .
obo:BFO_0000031 a owl:Class ; rdfs:label "generically dependent continuant"@en ; rdfs:subClassOf obo:BFO_0000002 .
obo:IAO_0000030 a owl:Class ;
    rdfs:label "information content entity"@en ;
    rdfs:subClassOf obo:BFO_0000031 ;
    skos:exactMatch biolink:InformationContentEntity .

obo:BFO_0000062 a owl:ObjectProperty , owl:TransitiveProperty ;
    rdfs:label "preceded by"@en ;
    owl:inverseOf obo:BFO_0000063 ;
    rdfs:domain obo:BFO_0000003 ;
    rdfs:range obo:BFO_0000003 ;
    skos:exactMatch biolink:preceded_by .

obo:BFO_0000063 a owl:ObjectProperty , owl:TransitiveProperty ;
    rdfs:label "precedes"@en ;
    rdfs:domain obo:BFO_0000003 ;
    rdfs:range obo:BFO_0000003 ;
    skos:exactMatch biolink:precedes .

obo:RO_0000057 a owl:ObjectProperty ;
    rdfs:label "has participant"@en ;
    rdfs:domain obo:BFO_0000003 ;
    rdfs:range obo:BFO_0000002 .

#####################################################################################################
# Reused OWL-Time terms -- axioms replicated from http://www.w3.org/2006/time (2017 Recommendation)
#####################################################################################################

time:TemporalEntity a owl:Class ; rdfs:label "Temporal entity"@en .
time:Instant        a owl:Class ; rdfs:label "Time instant"@en ; rdfs:subClassOf time:TemporalEntity .
time:Interval       a owl:Class ; rdfs:label "Time interval"@en ; rdfs:subClassOf time:TemporalEntity .
time:ProperInterval a owl:Class ; rdfs:label "Proper interval"@en ;
    rdfs:subClassOf time:Interval ;
    owl:disjointWith time:Instant .

time:hasTime a owl:ObjectProperty ; rdfs:label "has time"@en ; rdfs:range time:TemporalEntity .
time:hasBeginning a owl:ObjectProperty ; rdfs:label "has beginning"@en ;
    rdfs:subPropertyOf time:hasTime ; rdfs:domain time:TemporalEntity ; rdfs:range time:Instant .
time:hasEnd a owl:ObjectProperty ; rdfs:label "has end"@en ;
    rdfs:subPropertyOf time:hasTime ; rdfs:domain time:TemporalEntity ; rdfs:range time:Instant .
time:intervalMeets a owl:ObjectProperty ; rdfs:label "interval meets"@en ;
    rdfs:domain time:ProperInterval ; rdfs:range time:ProperInterval ; owl:inverseOf time:intervalMetBy .
time:intervalMetBy a owl:ObjectProperty ; rdfs:label "interval met by"@en .
time:inXSDDateTimeStamp a owl:DatatypeProperty ; rdfs:label "in XSD date-time-stamp"@en ;
    rdfs:domain time:Instant ; rdfs:range xsd:dateTimeStamp .

#####################################################################################################
# Reused Biolink Model 4.4.5 classes -- is_a chain replicated from biolink_model.yaml (tag v4.4.5)
#####################################################################################################

biolink:NamedThing                 a owl:Class ; rdfs:label "named thing"@en .
biolink:InformationContentEntity   a owl:Class ; rdfs:label "information content entity"@en ; rdfs:subClassOf biolink:NamedThing .
biolink:Publication                a owl:Class ; rdfs:label "publication"@en ; rdfs:subClassOf biolink:InformationContentEntity .
biolink:DrugLabel                  a owl:Class ; rdfs:label "drug label"@en ; rdfs:subClassOf biolink:Publication .
biolink:ChemicalEntity             a owl:Class ; rdfs:label "chemical entity"@en ; rdfs:subClassOf biolink:NamedThing .
biolink:ChemicalMixture            a owl:Class ; rdfs:label "chemical mixture"@en ; rdfs:subClassOf biolink:ChemicalEntity .
biolink:MolecularMixture           a owl:Class ; rdfs:label "molecular mixture"@en ; rdfs:subClassOf biolink:ChemicalMixture .
biolink:Drug                       a owl:Class ; rdfs:label "drug"@en ; rdfs:subClassOf biolink:MolecularMixture .
biolink:BiologicalEntity           a owl:Class ; rdfs:label "biological entity"@en ; rdfs:subClassOf biolink:NamedThing .
biolink:OrganismalEntity           a owl:Class ; rdfs:label "organismal entity"@en ; rdfs:subClassOf biolink:BiologicalEntity .
biolink:IndividualOrganism         a owl:Class ; rdfs:label "individual organism"@en ; rdfs:subClassOf biolink:OrganismalEntity .
biolink:Case                       a owl:Class ; rdfs:label "case"@en ; rdfs:subClassOf biolink:IndividualOrganism .
biolink:DiseaseOrPhenotypicFeature a owl:Class ; rdfs:label "disease or phenotypic feature"@en ; rdfs:subClassOf biolink:BiologicalEntity .
biolink:Disease                    a owl:Class ; rdfs:label "disease"@en ; rdfs:subClassOf biolink:DiseaseOrPhenotypicFeature .
biolink:Association                a owl:Class ; rdfs:label "association"@en .

#####################################################################################################
# Reused domain terms (MONDO, ChEBI) -- labels and cross-references verified 2026-10-07 (EBI OLS4, ChEBI API, NLM MeSH)
#####################################################################################################

obo:MONDO_0005301 a owl:Class ;
    rdfs:label "multiple sclerosis"@en ;
    rdfs:subClassOf biolink:Disease ;
    oboInOwl:hasDbXref "MESH:D009103" .

obo:MONDO_0005314 a owl:Class ;
    rdfs:label "relapsing-remitting multiple sclerosis"@en ;
    rdfs:subClassOf obo:MONDO_0005301 ;
    oboInOwl:hasDbXref "MESH:D020529" .

obo:MONDO_0100053 a owl:Class ;
    rdfs:label "anaphylaxis"@en ;
    rdfs:subClassOf biolink:Disease ;
    oboInOwl:hasDbXref "MESH:D000707" .

obo:CHEBI_749565 a owl:Class ;
    rdfs:label "glatiramer acetate"@en ;
    rdfs:subClassOf biolink:ChemicalEntity ;
    skos:exactMatch <http://id.nlm.nih.gov/mesh/D000068717> ,
                    <http://purl.bioontology.org/ontology/RXNORM/84375> ;
    skos:broadMatch <http://purl.bioontology.org/ontology/RXNORM/214582> ;
    oboInOwl:hasDbXref "UNII:5M691HL4BO" ;
    rdfs:comment "RXNORM:84375 = precise ingredient (PIN) 'glatiramer acetate'; RXNORM:214582 = ingredient (IN) 'glatiramer' (RxNav, active since 04/2005). UNII taken from the DailyMed SPL ingredient element. Subclass axiom to biolink:ChemicalEntity is an alignment axiom asserted by this ontology."@en .

#####################################################################################################
# Core bitemporal classes
#####################################################################################################

iat:TemporalKnowledgeRecord a owl:Class ;
    rdfs:label "temporal knowledge record"@en ;
    skos:definition "An information content entity that asserts something about the world and carries exactly one valid time (when its content holds) and exactly one availability time (when it became available to a reasoner), and is recorded in exactly one knowledge source."@en ;
    rdfs:subClassOf obo:IAO_0000030 ,
        [ a owl:Restriction ; owl:onProperty iat:hasValidTime ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass time:ProperInterval ] ,
        [ a owl:Restriction ; owl:onProperty iat:knownFrom ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onDataRange xsd:dateTimeStamp ] ,
        [ a owl:Restriction ; owl:onProperty iat:recordedIn ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass iat:KnowledgeSource ] ,
        [ a owl:Restriction ; owl:onProperty iat:hasValidTime ;
          owl:allValuesFrom [ a owl:Class ; owl:intersectionOf (
              time:ProperInterval
              [ a owl:Restriction ; owl:onProperty time:hasBeginning ;
                owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass time:Instant ]
              [ a owl:Restriction ; owl:onProperty time:hasEnd ;
                owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass time:Instant ] ) ] ] ;
    rdfs:comment "An unknown availability time is allowed by the open-world semantics (the value exists but is not stated); as-of queries treat such records as NOT available (fail-closed)."@en .

iat:LabelVersion a owl:Class ;
    rdfs:label "label version"@en ;
    skos:definition "One published version of a structured product label (SPL) document. Valid time: from its SPL effective date until the effective date of the version that supersedes it. Availability: its DailyMed publication date."@en ;
    rdfs:subClassOf iat:TemporalKnowledgeRecord , biolink:DrugLabel ,
        [ a owl:Restriction ; owl:onProperty iat:versionOf ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass iat:LabelSet ] ,
        [ a owl:Restriction ; owl:onProperty iat:splVersion ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onDataRange xsd:integer ] ,
        [ a owl:Restriction ; owl:onProperty iat:containsBoxedWarningSection ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onDataRange xsd:boolean ] .

iat:LabelSet a owl:Class ;
    rdfs:label "label set"@en ;
    skos:definition "The evolving drug label identified by one SPL set id; it has a sequence of label versions."@en ;
    rdfs:subClassOf obo:IAO_0000030 , biolink:DrugLabel ,
        [ a owl:Restriction ; owl:onProperty iat:labelFor ; owl:someValuesFrom iat:DrugProduct ] ,
        [ a owl:Restriction ; owl:onProperty iat:splSetId ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onDataRange xsd:string ] .

iat:LabelingChangeRecord a owl:Class ;
    rdfs:label "labeling change record"@en ;
    skos:definition "An entry of the FDA Drug Safety-related Labeling Changes (SrLC) database describing an approved labeling supplement."@en ;
    rdfs:subClassOf iat:TemporalKnowledgeRecord ,
        [ a owl:Restriction ; owl:onProperty iat:describesEvent ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass iat:LabelingSupplementApproval ] ,
        [ a owl:Restriction ; owl:onProperty iat:supplementNumber ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onDataRange xsd:string ] .

iat:SafetyCommunication a owl:Class ;
    rdfs:label "safety communication"@en ;
    skos:definition "A dated public regulatory communication about a drug safety issue (e.g. an FDA Drug Safety Communication)."@en ;
    rdfs:subClassOf iat:TemporalKnowledgeRecord , biolink:Publication .

iat:ClinicalAssertion a owl:Class ;
    rdfs:label "clinical assertion"@en ;
    skos:definition "A patient-level record (e.g. a diagnosis or a prescription entry) with its own valid time and the time it was entered in the record system."@en ;
    rdfs:subClassOf iat:TemporalKnowledgeRecord ,
        [ a owl:Restriction ; owl:onProperty iat:aboutPatient ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass iat:SyntheticPatient ] .

iat:DiagnosisAssertion a owl:Class ;
    rdfs:label "diagnosis assertion"@en ;
    rdfs:subClassOf iat:ClinicalAssertion ,
        [ a owl:Restriction ; owl:onProperty iat:assertsCondition ; owl:someValuesFrom biolink:Disease ] ;
    owl:disjointWith iat:PrescriptionRecord .

iat:PrescriptionRecord a owl:Class ;
    rdfs:label "prescription record"@en ;
    rdfs:subClassOf iat:ClinicalAssertion ,
        [ a owl:Restriction ; owl:onProperty iat:documentsEvent ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass iat:PrescriptionEvent ] .

iat:BitemporalAssociation a owl:Class ;
    rdfs:label "bitemporal association"@en ;
    skos:definition "A Biolink-style association (subject, predicate, object as Biolink slots) that is also a temporal knowledge record, i.e. carries OWL-Time valid time and an availability time. Derived associations must not become available before the records they are derived from."@en ;
    rdfs:subClassOf iat:TemporalKnowledgeRecord , biolink:Association ,
        [ a owl:Restriction ; owl:onProperty iat:derivedFrom ; owl:someValuesFrom iat:TemporalKnowledgeRecord ] .

[] a owl:AllDisjointClasses ;
   owl:members ( iat:LabelVersion iat:LabelingChangeRecord iat:SafetyCommunication iat:ClinicalAssertion iat:BitemporalAssociation ) .

iat:SafetyWarning a owl:Class ;
    rdfs:label "safety warning"@en ;
    skos:definition "A regulatory safety warning about a drug product and a hazard. Its valid time is the period in which the warning is in force; it is known only through records that attest it."@en ;
    rdfs:subClassOf obo:IAO_0000030 ,
        [ a owl:Restriction ; owl:onProperty iat:hasValidTime ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass time:ProperInterval ] ,
        [ a owl:Restriction ; owl:onProperty iat:concernsProduct ; owl:someValuesFrom iat:DrugProduct ] ,
        [ a owl:Restriction ; owl:onProperty [ owl:inverseOf iat:attests ] ; owl:someValuesFrom iat:TemporalKnowledgeRecord ] .

iat:BoxedWarning a owl:Class ;
    rdfs:label "boxed warning"@en ;
    skos:definition "A safety warning placed in the Boxed Warning section of US prescription drug labeling (SPL section LOINC 34066-1)."@en ;
    rdfs:subClassOf iat:SafetyWarning .

iat:KnowledgeSource a owl:Class ;
    rdfs:label "knowledge source"@en ;
    skos:definition "A database, publication channel or record system from which temporal knowledge records are obtained. Where it exists, its Biolink infores identifier is given with iat:inforesId."@en .

iat:DrugProduct a owl:Class ;
    rdfs:label "drug product"@en ;
    skos:definition "A marketed drug product identified at the RxNorm branded or clinical drug level."@en ;
    rdfs:subClassOf biolink:Drug ,
        [ a owl:Restriction ; owl:onProperty iat:rxcui ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onDataRange xsd:string ] .

iat:GlatiramerAcetateProduct a owl:Class ;
    rdfs:label "glatiramer acetate product"@en ;
    skos:definition "A drug product with glatiramer acetate (ChEBI) as active ingredient (defined class; membership is inferred)."@en ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( iat:DrugProduct
        [ a owl:Restriction ; owl:onProperty iat:hasActiveIngredient ; owl:someValuesFrom obo:CHEBI_749565 ] ) ] .

iat:SyntheticPatient a owl:Class ;
    rdfs:label "synthetic patient"@en ;
    skos:definition "A computer-generated or hand-authored patient used for demonstration. Contains no protected health information."@en ;
    rdfs:subClassOf biolink:Case .

[] a owl:AllDisjointClasses ;
   owl:members ( iat:TemporalKnowledgeRecord iat:SafetyWarning iat:LabelSet iat:KnowledgeSource
                 iat:DrugProduct iat:SyntheticPatient time:TemporalEntity ) .

iat:ClinicalEvent a owl:Class ;
    rdfs:label "clinical event"@en ;
    rdfs:subClassOf obo:BFO_0000015 .

iat:PrescriptionEvent a owl:Class ;
    rdfs:label "prescription event"@en ;
    skos:definition "The act of prescribing a drug product to a patient at an instant."@en ;
    skos:relatedMatch biolink:DrugExposure ;
    rdfs:subClassOf iat:ClinicalEvent ,
        [ a owl:Restriction ; owl:onProperty iat:hasPatient ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass iat:SyntheticPatient ] ,
        [ a owl:Restriction ; owl:onProperty iat:prescribedProduct ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass iat:DrugProduct ] ,
        [ a owl:Restriction ; owl:onProperty iat:occursAt ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass time:Instant ] .

iat:RegulatoryEvent a owl:Class ;
    rdfs:label "regulatory event"@en ;
    rdfs:subClassOf obo:BFO_0000015 .

iat:LabelingSupplementApproval a owl:Class ;
    rdfs:label "labeling supplement approval"@en ;
    skos:definition "FDA approval of a supplement that changes the labeling of an approved application."@en ;
    rdfs:subClassOf iat:RegulatoryEvent ,
        [ a owl:Restriction ; owl:onProperty iat:occursAt ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass time:Instant ] .

iat:AsOfSafetyCheck a owl:Class ;
    rdfs:label "as-of safety check"@en ;
    skos:definition "A decision-support or audit evaluation of a prescription performed as of an instant T, using only records available at T."@en ;
    rdfs:subClassOf obo:BFO_0000015 ,
        [ a owl:Restriction ; owl:onProperty iat:evaluatedAsOf ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onDataRange xsd:dateTimeStamp ] ,
        [ a owl:Restriction ; owl:onProperty iat:checksPrescription ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass iat:PrescriptionEvent ] .

iat:CheckRaisingBoxedWarning a owl:Class ;
    rdfs:label "check raising a boxed warning"@en ;
    skos:definition "An as-of safety check that used at least one record attesting a boxed warning (defined class; membership is inferred)."@en ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( iat:AsOfSafetyCheck
        [ a owl:Restriction ; owl:onProperty iat:usedRecord ;
          owl:someValuesFrom [ a owl:Restriction ; owl:onProperty iat:attests ; owl:someValuesFrom iat:BoxedWarning ] ] ) ] .

[] a owl:AllDisjointClasses ;
   owl:members ( iat:ClinicalEvent iat:RegulatoryEvent iat:AsOfSafetyCheck ) .

# Data-quality axiom (general class inclusion): a label version that includes a boxed warning must have the
# Boxed Warning SPL section. Asserting the opposite makes the ontology inconsistent.
[ a owl:Class ; owl:intersectionOf ( iat:LabelVersion
      [ a owl:Restriction ; owl:onProperty iat:includesWarning ; owl:someValuesFrom iat:BoxedWarning ] ) ]
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty iat:containsBoxedWarningSection ; owl:hasValue true ] .

#####################################################################################################
# As-of view classes (pattern: KnownAsOf_T == record and knownFrom <= T)
# Generated for the three query instants of the demonstration scenario.
#####################################################################################################

iat:KnownAsOf_20240614T150000Z a owl:Class ;
    rdfs:label "known as of 2024-06-14T15:00:00Z"@en ;
    skos:definition "Records whose availability time is on or before 2024-06-14T15:00:00Z (first prescription)."@en ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( iat:TemporalKnowledgeRecord
        [ a owl:Restriction ; owl:onProperty iat:knownFrom ;
          owl:someValuesFrom [ a rdfs:Datatype ; owl:onDatatype xsd:dateTimeStamp ;
                               owl:withRestrictions ( [ xsd:maxInclusive "2024-06-14T15:00:00Z"^^xsd:dateTimeStamp ] ) ] ] ) ] .

iat:KnownAsOf_20250123T150000Z a owl:Class ;
    rdfs:label "known as of 2025-01-23T15:00:00Z"@en ;
    skos:definition "Records whose availability time is on or before 2025-01-23T15:00:00Z (after the FDA communication, before the new label reached DailyMed)."@en ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( iat:TemporalKnowledgeRecord
        [ a owl:Restriction ; owl:onProperty iat:knownFrom ;
          owl:someValuesFrom [ a rdfs:Datatype ; owl:onDatatype xsd:dateTimeStamp ;
                               owl:withRestrictions ( [ xsd:maxInclusive "2025-01-23T15:00:00Z"^^xsd:dateTimeStamp ] ) ] ] ) ] .

iat:KnownAsOf_20250314T150000Z a owl:Class ;
    rdfs:label "known as of 2025-03-14T15:00:00Z"@en ;
    skos:definition "Records whose availability time is on or before 2025-03-14T15:00:00Z (second prescription)."@en ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( iat:TemporalKnowledgeRecord
        [ a owl:Restriction ; owl:onProperty iat:knownFrom ;
          owl:someValuesFrom [ a rdfs:Datatype ; owl:onDatatype xsd:dateTimeStamp ;
                               owl:withRestrictions ( [ xsd:maxInclusive "2025-03-14T15:00:00Z"^^xsd:dateTimeStamp ] ) ] ] ) ] .

#####################################################################################################
# Object properties
#####################################################################################################

iat:hasValidTime a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has valid time"@en ;
    skos:definition "Relates a record or a warning to the OWL-Time proper interval during which its content holds in the world. An interval without time:hasEnd is open (still holding as far as is known)."@en ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( iat:TemporalKnowledgeRecord iat:SafetyWarning ) ] ;
    rdfs:range time:ProperInterval ;
    skos:closeMatch biolink:temporal_interval_qualifier .

iat:recordedIn a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "recorded in"@en ;
    rdfs:domain iat:TemporalKnowledgeRecord ;
    rdfs:range iat:KnowledgeSource ;
    skos:closeMatch biolink:primary_knowledge_source .

iat:attests a owl:ObjectProperty ;
    rdfs:label "attests"@en ;
    skos:definition "A record states the existence of a regulatory entity such as a safety warning."@en ;
    rdfs:domain iat:TemporalKnowledgeRecord .

iat:includesWarning a owl:ObjectProperty ;
    rdfs:label "includes warning"@en ;
    rdfs:subPropertyOf iat:attests ;
    rdfs:domain iat:LabelVersion ;
    rdfs:range iat:SafetyWarning .

iat:announcesWarning a owl:ObjectProperty ;
    rdfs:label "announces warning"@en ;
    rdfs:subPropertyOf iat:attests ;
    rdfs:domain iat:SafetyCommunication ;
    rdfs:range iat:SafetyWarning .

iat:approvesWarning a owl:ObjectProperty ;
    rdfs:label "approves warning"@en ;
    rdfs:subPropertyOf iat:attests ;
    rdfs:domain iat:LabelingChangeRecord ;
    rdfs:range iat:SafetyWarning .

iat:versionOf a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "version of"@en ;
    rdfs:domain iat:LabelVersion ;
    rdfs:range iat:LabelSet ;
    owl:inverseOf iat:hasVersion .

iat:hasVersion a owl:ObjectProperty , owl:InverseFunctionalProperty ;
    rdfs:label "has version"@en ;
    rdfs:domain iat:LabelSet ;
    rdfs:range iat:LabelVersion .

iat:laterVersionOf a owl:ObjectProperty , owl:TransitiveProperty ;
    rdfs:label "later version of"@en ;
    rdfs:domain iat:LabelVersion ;
    rdfs:range iat:LabelVersion .

iat:supersedes a owl:ObjectProperty , owl:FunctionalProperty , owl:InverseFunctionalProperty ,
                 owl:AsymmetricProperty , owl:IrreflexiveProperty ;
    rdfs:label "supersedes"@en ;
    skos:definition "Direct succession of label versions: each version supersedes at most one version and is superseded by at most one."@en ;
    rdfs:subPropertyOf iat:laterVersionOf ;
    skos:closeMatch prov:wasRevisionOf .

iat:endAttestedBy a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "end attested by"@en ;
    skos:definition "Links a valid-time interval to the record that revealed its end. The end of a validity interval is itself knowledge: an as-of query may use time:hasEnd only if this record is available at T."@en ;
    rdfs:domain time:ProperInterval ;
    rdfs:range iat:TemporalKnowledgeRecord .

iat:labelFor a owl:ObjectProperty ;
    rdfs:label "label for"@en ;
    rdfs:domain iat:LabelSet ;
    rdfs:range iat:DrugProduct .

iat:warnsAbout a owl:ObjectProperty ;
    rdfs:label "warns about"@en ;
    rdfs:domain iat:SafetyWarning ;
    skos:relatedMatch biolink:has_adverse_event .

iat:concernsProduct a owl:ObjectProperty ;
    rdfs:label "concerns product"@en ;
    rdfs:domain iat:SafetyWarning ;
    rdfs:range iat:DrugProduct .

iat:hasActiveIngredient a owl:ObjectProperty ;
    rdfs:label "has active ingredient"@en ;
    rdfs:domain iat:DrugProduct ;
    skos:exactMatch biolink:has_active_ingredient .

iat:aboutPatient a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "about patient"@en ;
    rdfs:domain iat:ClinicalAssertion ;
    rdfs:range iat:SyntheticPatient .

iat:assertsCondition a owl:ObjectProperty ;
    rdfs:label "asserts condition"@en ;
    rdfs:domain iat:DiagnosisAssertion .

iat:documentsEvent a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "documents event"@en ;
    rdfs:domain iat:PrescriptionRecord ;
    rdfs:range iat:PrescriptionEvent .

iat:hasPatient a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has patient"@en ;
    rdfs:subPropertyOf obo:RO_0000057 ;
    rdfs:domain iat:PrescriptionEvent ;
    rdfs:range iat:SyntheticPatient .

iat:prescribedProduct a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "prescribed product"@en ;
    rdfs:domain iat:PrescriptionEvent ;
    rdfs:range iat:DrugProduct .

iat:occursAt a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "occurs at"@en ;
    rdfs:subPropertyOf time:hasTime ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( iat:ClinicalEvent iat:RegulatoryEvent ) ] ;
    rdfs:range time:Instant .

iat:describesEvent a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "describes event"@en ;
    rdfs:domain iat:LabelingChangeRecord ;
    rdfs:range iat:LabelingSupplementApproval .

iat:usedRecord a owl:ObjectProperty ;
    rdfs:label "used record"@en ;
    skos:definition "A record consulted by an as-of safety check."@en ;
    rdfs:domain iat:AsOfSafetyCheck ;
    rdfs:range iat:TemporalKnowledgeRecord .

iat:checksPrescription a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "checks prescription"@en ;
    rdfs:domain iat:AsOfSafetyCheck ;
    rdfs:range iat:PrescriptionEvent .

iat:derivedFrom a owl:ObjectProperty ;
    rdfs:label "derived from"@en ;
    rdfs:domain iat:TemporalKnowledgeRecord ;
    rdfs:range iat:TemporalKnowledgeRecord ;
    skos:exactMatch prov:wasDerivedFrom .

#####################################################################################################
# Datatype properties
#####################################################################################################

iat:knownFrom a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "known from"@en ;
    skos:definition "Availability (knowledge) time: the instant from which the record could be known to a reasoner through its knowledge source. An inference as of T may use the record only if knownFrom <= T."@en ;
    rdfs:domain iat:TemporalKnowledgeRecord ;
    rdfs:range xsd:dateTimeStamp ;
    skos:relatedMatch prov:generatedAtTime ;
    rdfs:comment "Named knownFrom (not availableFrom) to avoid confusion with the Biolink slot available_from (the regulatory or commercial availability channel of a drug, DrugAvailabilityEnum). Biolink Model 4.4.5 offers record-keeping dates (creation_date, update_date; dataset-level retrieved_on, ingest_date) and string-serialised temporal qualifiers, but no edge-level time at which the knowledge became available in its primary source; this property fills that gap."@en .

iat:evaluatedAsOf a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "evaluated as of"@en ;
    rdfs:domain iat:AsOfSafetyCheck ;
    rdfs:range xsd:dateTimeStamp .

iat:splVersion a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "SPL version number"@en ;
    rdfs:domain iat:LabelVersion ;
    rdfs:range xsd:integer .

iat:splDocumentId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "SPL document id"@en ;
    rdfs:domain iat:LabelVersion ;
    rdfs:range xsd:string .

iat:splSetId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "SPL set id"@en ;
    rdfs:domain iat:LabelSet ;
    rdfs:range xsd:string .

iat:applicationNumber a owl:DatatypeProperty ;
    rdfs:label "FDA application number"@en ;
    rdfs:domain iat:LabelSet ;
    rdfs:range xsd:string .

iat:supplementNumber a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "supplement number"@en ;
    rdfs:domain iat:LabelingChangeRecord ;
    rdfs:range xsd:string .

iat:rxcui a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "RxNorm concept unique identifier"@en ;
    rdfs:domain iat:DrugProduct ;
    rdfs:range xsd:string .

iat:rxnormTermType a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "RxNorm term type"@en ;
    rdfs:domain iat:DrugProduct ;
    rdfs:range xsd:string .

iat:containsBoxedWarningSection a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "contains Boxed Warning section"@en ;
    skos:definition "Whether the SPL document contains a section coded LOINC 34066-1 (Boxed Warning)."@en ;
    rdfs:domain iat:LabelVersion ;
    rdfs:range xsd:boolean .

