# ---------- FDA Drug Safety Communication ----------

iatd:dsc_2025-01-22_glatiramer a owl:NamedIndividual , iat:SafetyCommunication ;
    rdfs:label "FDA Drug Safety Communication 2025-01-22: Boxed Warning about anaphylaxis with glatiramer acetate (Copaxone, Glatopa)"@en ;
    iat:announcesWarning iatd:bw_glatiramer_anaphylaxis ;
    iat:hasValidTime iatd:vt_boxed_warning ;
    iat:knownFrom "2025-01-22T23:59:59-12:00"^^xsd:dateTimeStamp ;
    iat:sourceDateText "01-22-2025 (page); 1-22-2025 (list)" ;
    iat:recordedIn iatd:src_fda_dsc ;
    dcterms:source <https://www.fda.gov/drugs/drug-safety-communications/fda-adds-boxed-warning-about-rare-serious-allergic-reaction-called-anaphylaxis-multiple-sclerosis> ;
    iat:accessedOn "2026-10-07"^^xsd:date ;
    rdfs:comment "The web page was later edited (content current as of 04/03/2026); the communication itself is dated 2025-01-22."@en .

# ---------- Biolink-style association with bitemporal qualifiers (derived record) ----------

iatd:assoc_glatiramer_anaphylaxis a owl:NamedIndividual , iat:BitemporalAssociation ;
    rdfs:label "glatiramer acetate -- has adverse event --> anaphylaxis (boxed-warning level)"@en ;
    biolink:subject obo:CHEBI_749565 ;
    biolink:predicate biolink:has_adverse_event ;
    biolink:object obo:MONDO_0100053 ;
    biolink:knowledge_level "knowledge_assertion" ;
    biolink:agent_type "manual_agent" ;
    iat:derivedFrom iatd:dsc_2025-01-22_glatiramer ;
    iat:hasValidTime iatd:vt_boxed_warning ;
    iat:knownFrom "2025-01-22T23:59:59-12:00"^^xsd:dateTimeStamp ;
    iat:recordedIn iatd:src_this_kg ;
    rdfs:comment "Valid time = period during which FDA labeling states this association at boxed-warning level; it does not claim when the biological risk began. Availability = availability of the record it is derived from."@en .

