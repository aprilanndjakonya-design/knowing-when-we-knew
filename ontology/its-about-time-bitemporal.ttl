# ---------- The boxed warning ----------

iatd:vt_boxed_warning a owl:NamedIndividual , time:ProperInterval ;
    rdfs:label "in force since approval of SUPPL-119 (open)"@en ;
    time:hasBeginning iatd:t_2025-01-22 .

iatd:bw_glatiramer_anaphylaxis a owl:NamedIndividual , iat:BoxedWarning ,
        [ a owl:Restriction ; owl:onProperty iat:warnsAbout ; owl:someValuesFrom obo:MONDO_0100053 ] ;
    rdfs:label "Boxed Warning: anaphylactic reactions with glatiramer acetate (Copaxone)"@en ;
    iat:concernsProduct iatd:rxcui_1111642 , iatd:rxcui_1487363 ;
    iat:hasValidTime iatd:vt_boxed_warning ;
