[] a owl:AllDifferent ;
   owl:distinctMembers ( iatd:approval_suppl116 iatd:approval_suppl119 iatd:approval_suppl121 ) .

iatd:vt_suppl116 a owl:NamedIndividual , time:ProperInterval ; time:hasBeginning iatd:t_2023-11-16 .
iatd:vt_suppl121 a owl:NamedIndividual , time:ProperInterval ; time:hasBeginning iatd:t_2026-06-22 .

