# ---------- As-of safety checks (retrospective audit of each prescription) ----------
# Each check is contractually restricted to records of its as-of view: using any record that became available
# after T makes the ontology inconsistent (see validation_report.txt for the counter-examples).

iatd:check_SYN001_2024-06 a owl:NamedIndividual , iat:AsOfSafetyCheck ,
        [ a owl:Restriction ; owl:onProperty iat:usedRecord ; owl:allValuesFrom iat:KnownAsOf_20240614T150000Z ] ;
    rdfs:label "As-of safety check of the 2024-06-14 prescription"@en ;
    iat:checksPrescription iatd:rx_SYN001_2024-06 ;
    iat:evaluatedAsOf "2024-06-14T15:00:00Z"^^xsd:dateTimeStamp ;
    iat:usedRecord iatd:label_v32 , iatd:dx_SYN001_rrms , iatd:rxrec_SYN001_2024-06 ;
    rdfs:comment "Result: no boxed warning was known; the prescription was consistent with the knowledge available at that time."@en .

iatd:check_SYN001_2025-03 a owl:NamedIndividual , iat:AsOfSafetyCheck ,
        [ a owl:Restriction ; owl:onProperty iat:usedRecord ; owl:allValuesFrom iat:KnownAsOf_20250314T150000Z ] ;
    rdfs:label "As-of safety check of the 2025-03-14 prescription"@en ;
    iat:checksPrescription iatd:rx_SYN001_2025-03 ;
    iat:evaluatedAsOf "2025-03-14T15:00:00Z"^^xsd:dateTimeStamp ;
    iat:usedRecord iatd:label_v35 , iatd:dsc_2025-01-22_glatiramer , iatd:assoc_glatiramer_anaphylaxis ,
                   iatd:dx_SYN001_rrms , iatd:rxrec_SYN001_2025-03 ;
    rdfs:comment "Result: the boxed warning on anaphylaxis was known and must be shown to the prescriber."@en .
